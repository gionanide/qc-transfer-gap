{
  "architecture": "attnunet",
  "constructor": "AttentionUnet",
  "monai_version": "1.5.2",
  "constructor_kwargs": {
    "spatial_dims": 2,
    "in_channels": 1,
    "out_channels": 4,
    "channels": [
      32,
      64,
      128,
      256,
      512
    ],
    "strides": [
      2,
      2,
      2,
      2
    ],
    "dropout": 0.1
  },
  "input_shape": [
    1,
    256,
    256
  ],
  "training": {
    "epochs": 100,
    "batch_size": 16,
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "DiceCELoss(to_onehot_y=True, softmax=True)",
    "scheduler": "CosineAnnealingLR(T_max=100)",
    "validation_fraction_in_preserved_config": 0.15,
    "stratified_split_seed": 42,
    "augmentation": "independent horizontal and vertical flips",
    "deployment_checkpoint": "final epoch; not best-by-EF"
  },
  "note": "Unspecified constructor parameters use the pinned MONAI defaults. The separate Table S11 split reconstruction uses validation_fraction=0.20."
}
